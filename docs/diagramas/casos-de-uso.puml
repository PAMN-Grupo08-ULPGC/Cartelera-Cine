@startuml casos-de-uso
' Diagrama de casos de uso (provisional) - Cartelera de Cine
left to right direction
skinparam packageStyle rectangle

actor "Cliente" as Cliente
actor "Invitado" as Invitado
actor "Trabajador" as Trabajador
actor "Servicio externo" as Servicio <<sistema>>

' Cliente y Trabajador pueden hacer todo lo que hace un invitado
Cliente -|> Invitado
Trabajador -|> Invitado

rectangle "Sistema Cartelera de Cine" {
  usecase "Ver detalle y sesiones" as UC1
  usecase "Seleccionar asientos" as UC2
  usecase "Bloquear asientos" as UC3
  usecase "Pagar entradas (simulado)" as UC4
  usecase "Generar QR" as UC5
  usecase "Ver mis entradas (QR)" as UC6
  usecase "Recibir aviso previo a la sesión" as UC7
  usecase "Cerrar sesión" as UC8
  usecase "Consultar cartelera" as UC9
  usecase "Buscar y filtrar películas" as UC10
  usecase "Cambiar de cine" as UC11
  usecase "Registrarse" as UC12
  usecase "Iniciar sesión" as UC13
  usecase "Escanear QR" as UC14
  usecase "Validar entrada" as UC15
  usecase "Liberar reservas caducadas" as UC16
}

Cliente --> UC1
Cliente --> UC2
Cliente --> UC4
Cliente --> UC6
Cliente --> UC7
Cliente --> UC8

Invitado --> UC9
Invitado --> UC10
Invitado --> UC11
Invitado --> UC12
Invitado --> UC13

Trabajador --> UC8
Trabajador --> UC14

UC2 ..> UC3 : <<include>>
UC4 ..> UC5 : <<include>>
UC14 ..> UC15 : <<include>>

UC3 <-- Servicio
UC15 <-- Servicio
UC16 <-- Servicio
@enduml
